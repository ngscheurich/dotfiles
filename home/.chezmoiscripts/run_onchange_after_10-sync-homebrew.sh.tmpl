#!/bin/sh

# Brewfile hash: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}

BUNDLE_FILE="$HOME/.config/homebrew/Brewfile"

brew trust --formula showwin/speedtest/speedtest
brew trust --formula timescale/tap/timescaledb
brew trust --formula timescale/tap/timescaledb-toolkit
brew trust --formula timescale/tap/timescaledb-tools

brew bundle install --file $BUNDLE_FILE
brew bundle cleanup --file $BUNDLE_FILE --force

