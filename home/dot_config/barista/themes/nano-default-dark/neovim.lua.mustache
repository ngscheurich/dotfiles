-- Palette <<<
local palette = {
  rosewater = "{{palette.rosewater}}",
  flamingo = "{{palette.flamingo}}",
  pink = "{{palette.pink}}",
  mauve = "{{palette.mauve}}",
  red = "{{palette.red}}",
  maroon = "{{palette.maroon}}",
  peach = "{{palette.peach}}",
  yellow = "{{palette.yellow}}",
  green = "{{palette.green}}",
  teal = "{{palette.teal}}",
  sky = "{{palette.sky}}",
  sapphire = "{{palette.sapphire}}",
  blue = "{{palette.blue}}",
  lavender = "{{palette.lavender}}",
  text = "{{palette.text}}",
  subtext1 = "{{palette.subtext_1}}",
  subtext0 = "{{palette.subtext_0}}",
  overlay2 = "{{palette.overlay_2}}",
  overlay1 = "{{palette.overlay_1}}",
  overlay0 = "{{palette.overlay_0}}",
  surface2 = "{{palette.surface_2}}",
  surface1 = "{{palette.surface_1}}",
  surface0 = "{{palette.surface_0}}",
  base = "{{palette.base}}",
  mantle = "{{palette.mantle}}",
  crust = "{{palette.crust}}",
}
-- >>>

local nano = {
  foreground = "#d4d0ca",
  background = "#262624",
  highlight = "#343432",
  subtle = "#484846",
  veryfaded = "#4e4e4c",
  faded = "#969690",
  salient = "#7a9db8",
  strong = "#f0efeb",
  popout = "#d08770",
  critical = "#e8c46a",
}

return {
  name = "{{name}}",

  setup = function()
    local ok, catppuccin = pcall(require, "catppuccin")

    if not ok then
      vim.notify("Barista requires `catppuccin`.", vim.log.levels.WARN)
      return
    end

    catppuccin.setup({
      color_overrides = {
        all = palette,
      },
    })

    vim.cmd.colorscheme("catppuccin")

    local groups = {
      -- Editor <<<
      ColorColumn = { bg = nano.highlight },
      Conceal = { fg = nano.salient, st = "bold" },
      CurSearch = { bg = nano.subtle, st = "bold" },
      CursorColumn = { bg = nano.highlight },
      CursorLine = { bg = palette.mantle },
      DiffAdd = { fg = nano.background, bg = nano.salient },
      DiffChange = { fg = nano.background, bg = nano.popout },
      DiffDelete = { fg = nano.background, bg = nano.faded },
      DiffText = { bg = nano.subtle },
      ErrorMsg = { fg = nano.critical },
      FloatBorder = { fg = palette.surface2, bg = palette.mantle },
      FloatTitle = { fg = nano.strong, bg = nano.subtle, st = "bold" },
      FoldColumn = { bg = nano.subtle },
      Folded = { fg = nano.salient, st = "bold" },
      IncSearch = { fg = nano.popout, bg = nano.subtle },
      LineNr = { fg = nano.faded },
      MatchParen = { bg = nano.subtle, st = "bold" },
      ModeMsg = { fg = nano.faded },
      MoreMsg = { fg = nano.foreground },
      NonText = { fg = nano.veryfaded, st = "italic" },
      Search = { bg = nano.subtle },
      SignColumn = { fg = nano.faded },
      SignColumnSB = { fg = nano.faded },
      SpellBad = { fg = nano.popout, sp = nano.popout, st = "undercurl" },
      SpellCap = { fg = nano.salient, sp = nano.salient, st = "undercurl" },
      SpellLocal = { fg = nano.faded, sp = nano.faded, st = "undercurl" },
      SpellRare = { fg = nano.faded, sp = nano.faded, st = "undercurl" },
      StatusLine = { fg = nano.foreground, bg = nano.subtle },
      StatusLineNC = { fg = nano.faded, bg = nano.subtle },
      Title = { fg = nano.strong },
      Visual = { bg = nano.subtle },
      WarningMsg = { fg = nano.popout },
      WinBar = { fg = nano.strong, st = "bold" },
      WinBarNC = { fg = nano.faded },
      healthSuccess = { fg = nano.salient },
      -- >>>

      -- Syntax <<<
      Boolean = { fg = nano.salient },
      Changed = { fg = nano.popout },
      Character = { fg = nano.faded },
      Comment = { fg = nano.faded },
      Conditional = { fg = nano.salient },
      Constant = { fg = nano.salient },
      Delimiter = { fg = nano.foreground },
      Error = { fg = nano.critical },
      Exception = { fg = nano.salient },
      Function = { fg = nano.strong },
      Identifier = { fg = nano.foreground },
      Include = { fg = nano.salient },
      Keyword = { fg = nano.salient },
      Label = { fg = nano.salient },
      Number = { fg = nano.salient },
      Operator = { fg = nano.foreground },
      PreCondit = { fg = nano.salient },
      PreProc = { fg = nano.salient },
      Removed = { fg = nano.faded },
      Repeat = { fg = nano.salient },
      Special = { fg = nano.salient },
      SpecialChar = { fg = nano.salient },
      Statement = { fg = nano.salient },
      StorageClass = { fg = nano.salient },
      String = { fg = nano.faded },
      Structure = { fg = nano.salient },
      Tag = { fg = nano.strong },
      Todo = { fg = nano.salient },
      Type = { fg = nano.salient },
      Typedef = { fg = nano.salient },
      Whitespace = { fg = nano.subtle },
      ["@property"] = { fg = nano.salient },
      -- >>>

      SnacksIndentScope = { fg = palette.surface0 },
      SnacksPickerDir = { fg = palette.overlay2, st = "italic" },
    }

    for name, opts in pairs(groups) do
      local fg = opts.fg or "NONE"
      local bg = opts.bg or "NONE"
      local st = opts.st or "NONE"
      local highlight = string.format("%s guifg=%s guibg=%s gui=%s", name, fg, bg, st)
      vim.cmd.highlight(highlight)
    end

    -- Statusline <<<
    vim.g.ngs_statusline = {
      fg = palette.subtext1,
      fg_alt = palette.subtext0,
      bg = palette.surface0,
      bg_alt = palette.surface1,

      mode_name_fg = palette.base,
      mode_icon_fg = palette.base,
      mode_normal = palette.overlay1,
      mode_visual = palette.lavender,
      mode_select = palette.teal,
      mode_insert = palette.green,
      mode_replace = palette.red,
      mode_command = palette.yellow,
      mode_ex = palette.yellow,
      mode_wait = palette.peach,
      mode_terminal = palette.blue,

      readonly = palette.red,

      vcs_branch = palette.mauve,
      vcs_added = palette.green,
      vcs_removed = palette.red,
      vcs_changed = palette.blue,

      diag_error = palette.red,
      diag_warning = palette.yellow,
      diag_info = palette.sapphire,
      diag_hint = palette.lavender,

      lsp = palette.blue,
    }
    -- >>>
  end,
}

