local palette = {
  rosewater = "{{palette.rosewater}}",
  flamingo = "{{palette.flamingo}}",
  pink = "{{palette.pink}}",
  mauve = "{{palette.mauve}}",
  red = "{{palette.red}}",
  maroon = "{{palette.maroon}}",
  peach = "{{palette.peach}}",
  yellow = "{{palette.yellow}}",
  green = "{{palette.green}}",
  teal = "{{palette.teal}}",
  sky = "{{palette.sky}}",
  sapphire = "{{palette.sapphire}}",
  blue = "{{palette.blue}}",
  lavender = "{{palette.lavender}}",
  text = "{{palette.text}}",
  subtext1 = "{{palette.subtext_1}}",
  subtext0 = "{{palette.subtext_0}}",
  overlay2 = "{{palette.overlay_2}}",
  overlay1 = "{{palette.overlay_1}}",
  overlay0 = "{{palette.overlay_0}}",
  surface2 = "{{palette.surface_2}}",
  surface1 = "{{palette.surface_1}}",
  surface0 = "{{palette.surface_0}}",
  base = "{{palette.base}}",
  mantle = "{{palette.mantle}}",
  crust = "{{palette.crust}}",
}

local style = {
  panel = { background = "#2f343e" },
  editor = {
    line_number = "#4e5a5f",
    active_line_number = "{{palette.subtext_0}}",
    active_line = { background = "#2f343e" },
  },
  version_control = {
    added = "#27a657",
    modified = "#d3b020",
    deleted = "#e06c76",
  },
  error = "#d07277",
  hint = "#788ca6",
  info = "{{palette.lavender}}",
  warning = "#dec184",
  syntax = { comment = { doc = "#878e98" }, operator = "#6eb4bf" },
}

return {
  name = "{{name}}",

  setup = function()
    local ok, catppuccin = pcall(require, "catppuccin")

    if not ok then
      vim.notify("Barista requires `catppuccin`.", vim.log.levels.WARN)
      return
    end

    catppuccin.setup({
      color_overrides = {
        all = palette,
      },
    })

    vim.cmd.colorscheme("catppuccin")

    local groups = {
      Comment = { fg = style.syntax.comment.doc, st = "italic" },
      CursorLine = { bg = style.editor.active_line.background },
      CursorLineNr = { fg = style.editor.active_line_number, bg = style.editor.active_line.background },
      DiagnosticError = { fg = style.error },
      DiagnosticHint = { fg = style.hint },
      DiagnosticInfo = { fg = style.info },
      DiagnosticWarn = { fg = style.warning },
      GitSignsAdd = { fg = style.version_control.added },
      GitSignsChange = { fg = style.version_control.modified },
      GitSignsDelete = { fg = style.version_control.deleted },
      LineNr = { fg = style.editor.line_number },
      Operator = { fg = style.syntax.operator },
      Pmenu = { bg = style.panel.background },
      SnacksIndent = { fg = "NONE" },
      SnacksIndentScope = { fg = "{{palette.surface_0}}" },
      SnacksPicker = { bg = style.panel.background },
      Visual = { bg = "{{palette.surface_0}}" },
      ["@property"] = { fg = "{{palette.red}}" },
      ["@punctuation.bracket"] = { fg = "{{palette.subtext_1}}" },
    }

    for name, opts in pairs(groups) do
      local fg = opts.fg or "NONE"
      local bg = opts.bg or "NONE"
      local st = opts.st or "NONE"
      local highlight = string.format("%s guifg=%s guibg=%s gui=%s", name, fg, bg, st)
      vim.cmd.highlight(highlight)
    end
  end,
}

-- vim:ft=lua
